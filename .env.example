# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/exam-portal

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# App
APP_URL=http://localhost:3000
TIMEZONE=Europe/London

# Email (SMTP - works with Gmail app password, Brevo, Mailtrap, etc. All free-tier friendly)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-smtp-password
MAIL_FROM="Al-Huda Exam Portal <no-reply@example.com>"

# Cloudinary (free tier) - for question images/audio uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial teacher account (used by scripts/seedTeacher.js)
TEACHER_EMAIL=teacher@example.com
TEACHER_PASSWORD=ChangeThisPassword123!

# Secret for the deadline-reminder cron endpoint (see README)
CRON_SECRET=replace-with-another-random-string
